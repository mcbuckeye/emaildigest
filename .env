# PostgreSQL
DATABASE_URL=postgresql+asyncpg://emaildigest:emaildigest@localhost:5432/emaildigest

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
SECRET_KEY=super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email (smtp2go)
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_FROM_EMAIL=noreply@emaildigest.machomelab.com
SMTP2GO_FROM_NAME=EmailDigest

# AI/LLM (for future AI-powered digest creation)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openrouter/deepseek/deepseek-r1-distill-llama-70b

# App
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=EmailDigest

# Docker
DOCKER_COMPOSE_PROJECT_NAME=emaildigest
