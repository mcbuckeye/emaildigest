# App
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=EmailDigest
APP_BASE_URL=http://localhost:3000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://emaildigest:emaildigest@localhost:5432/emaildigest

# Redis (Celery broker + backend)
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Rate limits
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_AI_CHAT=20/minute

# Email (smtp2go)
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_FROM_EMAIL=noreply@emaildigest.machomelab.com
SMTP2GO_FROM_NAME=EmailDigest
SMTP2GO_HOST=mail.smtp2go.com
SMTP2GO_PORT=2525

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
