# Production environment variables for EmailDigest
# These should be set in Dokploy secrets or environment files

# Application
APP_NAME=EmailDigest
APP_DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://emaildigest:emaildigest@db:5432/emaildigest

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-this-in-production-using-secrets-manager
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP2GO
SMTP2GO_API_KEY=your-smtp2go-api-key
SMTP2GO_FROM_EMAIL=noreply@emaildigest.machomelab.com
SMTP2GO_FROM_NAME=EmailDigest

# AI/LLM
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openrouter/deepseek/deepseek-r1-distill-llama-70b

# Logging
LOG_LEVEL=info

# Health check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
